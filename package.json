{
  "name": "synology-capture-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright spec: enumerate Synology DSM root shared folders + PII-aware screenshots",
  "scripts": {
    "postinstall": "playwright install chromium",
    "capture": "cross-env playwright test capture.spec.ts",
    "capture:headed": "cross-env playwright test capture.spec.ts --headed",
    "annotate": "python3 annotate.py pins.json",
    "annotate:py": "python annotate.py pins.json",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^26.0.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.6.0"
  }
}
